<Page
    x:Class="GHelper.GameBar.GHelperWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        A gamepad-first control surface.

        The ordering is deliberate: the gamepad controls come first because on a ROG Ally
        that is what you reach for mid-session, performance is second, and live telemetry is
        last because it is information rather than a control.

        The background is transparent so Game Bar's own acrylic shows through, and every
        surface is a translucent card with a hairline border rather than a solid panel.

        Two things about sizing drive the layout. The widget is 560 pixels wide, and the
        frame caps alone would need more than that, so every option strip lives in a
        horizontally scrolling host - a controller can walk the strip with the D-pad and the
        framework scrolls it to follow. And the switches are drawn from a custom template,
        because the stock ToggleSwitch reserves 156 pixels for a label nobody reads.

        The brushes are named page resources rather than theme dictionaries on purpose: the
        code creates buttons at runtime and needs the same instances, and changing a named
        brush's colour re-styles everything that uses it, which is how the theme is applied
        live. UWP has no FindResource, so this is also the only way to get at them.
    -->
    <Page.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Name="BrushCard" Color="#1FFFFFFF" />
            <SolidColorBrush x:Name="BrushCardStroke" Color="#26FFFFFF" />
            <SolidColorBrush x:Name="BrushSubtleText" Color="#99FFFFFF" />
            <SolidColorBrush x:Name="BrushFaintText" Color="#66FFFFFF" />
            <SolidColorBrush x:Name="BrushAccent" Color="#5FD35F" />
            <SolidColorBrush x:Name="BrushAccentSoft" Color="#335FD35F" />
            <SolidColorBrush x:Name="BrushAccentText" Color="#0B1A0B" />
            <SolidColorBrush x:Name="BrushIdleText" Color="#FFFFFFFF" />
            <SolidColorBrush x:Name="BrushWarn" Color="#FFC46B" />
            <SolidColorBrush x:Name="BrushTrack" Color="#26FFFFFF" />
            <SolidColorBrush x:Name="BrushIdleButton" Color="#14FFFFFF" />

            <!-- A thin, rounded bar for the live load gauges. -->
            <Style x:Key="Gauge" TargetType="ProgressBar">
                <Setter Property="Height" Value="4" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                <Setter Property="Background" Value="{StaticResource BrushTrack}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Section label: small, quiet, wide. -->
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9" />
                <Setter Property="Foreground" Value="{StaticResource BrushFaintText}" />
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>

            <!-- The same label, but sitting beside a control instead of above it. -->
            <Style x:Key="InlineLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- A segmented button. The selected state is painted from code-behind so the
                 accent can pulse when a change is applied. -->
            <Style x:Key="Segment" TargetType="Button">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="8,3,8,3" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Foreground" Value="{StaticResource BrushIdleText}" />
                <Setter Property="Background" Value="{StaticResource BrushIdleButton}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushCardStroke}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- The strips sit inside a horizontally scrolling host, so a long option list
                 (the ten frame caps, for instance) stays usable in a widget that is only a
                 few hundred pixels wide. -->
            <Style x:Key="Strip" TargetType="ScrollViewer">
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollMode" Value="Auto" />
                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="VerticalScrollMode" Value="Disabled" />
            </Style>

            <!--
                A switch is drawn as a segment rather than a ToggleSwitch.

                The stock ToggleSwitch reserves 156 pixels for a label nobody reads, so
                three of them in a row do not fit the widget at all. A segment that fills
                with the accent when it is on says the same thing in half the width, and it
                matches every other control on the page.
            -->
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="Root" Background="Transparent" Padding="12,10,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="G-HELPER"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BrushAccent}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="1"
                       x:Name="txtModel"
                       Margin="10,0,0,0"
                       FontSize="12"
                       Opacity="0.75"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Text="" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock x:Name="txtPowerSource"
                           FontSize="11"
                           Foreground="{StaticResource BrushSubtleText}"
                           VerticalAlignment="Center"
                           Text="" />
                <Ellipse x:Name="dotStatus" Width="7" Height="7" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      HorizontalScrollMode="Disabled">
            <StackPanel x:Name="panelContent" Spacing="6">

                <!-- ── Gamepad: the primary control surface ── -->
                <Border x:Name="cardGamepad"
                        Padding="12,8"
                        CornerRadius="10"
                        Background="{StaticResource BrushCard}"
                        BorderBrush="{StaticResource BrushCardStroke}"
                        BorderThickness="1">
                    <StackPanel Spacing="7">

                        <!-- Controller mode: the single most useful Ally switch. -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="CONTROLLER" Style="{StaticResource InlineLabel}" />
                            <ScrollViewer Grid.Column="1" Style="{StaticResource Strip}">
                                <StackPanel x:Name="panelControllerModes" Orientation="Horizontal" Spacing="4" />
                            </ScrollViewer>
                        </Grid>

                        <!-- Frame caps. Ten of them, so this one scrolls. -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="FPS CAP" Style="{StaticResource InlineLabel}" />
                            <ScrollViewer Grid.Column="1" Style="{StaticResource Strip}">
                                <StackPanel x:Name="panelFpsCaps" Orientation="Horizontal" Spacing="4" />
                            </ScrollViewer>
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource BrushCardStroke}" Margin="0,1" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="VIBRATION" Style="{StaticResource InlineLabel}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button x:Name="buttonVibrationOff" Style="{StaticResource Segment}" Content="Normal" Tag="0" Click="VibrationClick" />
                                <Button x:Name="buttonVibrationOn" Style="{StaticResource Segment}" Content="Enhanced" Tag="1" Click="VibrationClick" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button x:Name="buttonAutoTdp"
                                        Style="{StaticResource Segment}"
                                        Content="Auto TDP"
                                        Click="AutoTdpClick" />
                            </StackPanel>

                            <StackPanel Grid.Column="3"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="TDP" Style="{StaticResource InlineLabel}" />
                                <TextBlock x:Name="txtTdp"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="--"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Performance ── -->
                <Border x:Name="cardPerformance"
                        Padding="12,8"
                        CornerRadius="10"
                        Background="{StaticResource BrushCard}"
                        BorderBrush="{StaticResource BrushCardStroke}"
                        BorderThickness="1">
                    <StackPanel Spacing="7">
                        <TextBlock Text="PERFORMANCE" Style="{StaticResource SectionLabel}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="MODE" Style="{StaticResource InlineLabel}" />
                            <ScrollViewer Grid.Column="1" Style="{StaticResource Strip}">
                                <StackPanel x:Name="panelModes" Orientation="Horizontal" Spacing="4" />
                            </ScrollViewer>
                        </Grid>

                        <!-- Both columns are star-sized on purpose. A ScrollViewer reports a
                             zero desired width in the scrolling direction, so an auto-sized
                             column would collapse the strip to nothing. -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="GPU" Style="{StaticResource InlineLabel}" />
                            <ScrollViewer Grid.Column="1" Style="{StaticResource Strip}">
                                <StackPanel x:Name="panelGpuModes" Orientation="Horizontal" Spacing="4" />
                            </ScrollViewer>

                            <TextBlock Grid.Column="2" Text="SCREEN" Style="{StaticResource InlineLabel}" />
                            <ScrollViewer Grid.Column="3" Style="{StaticResource Strip}">
                                <StackPanel x:Name="panelScreenModes" Orientation="Horizontal" Spacing="4" />
                            </ScrollViewer>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Live telemetry ── -->
                <Border x:Name="cardLive"
                        Padding="12,8"
                        CornerRadius="10"
                        Background="{StaticResource BrushCard}"
                        BorderBrush="{StaticResource BrushCardStroke}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="txtFps"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           LineHeight="32"
                                           Text="--" />
                                <TextBlock Text="FPS"
                                           FontSize="10"
                                           Foreground="{StaticResource BrushFaintText}"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,4" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="NOW PLAYING" Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="txtFocusedApp"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           Text="" />
                            </StackPanel>
                        </Grid>

                        <!-- CPU / GPU / memory, side by side. -->
                        <Grid x:Name="panelGauges" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="3">
                                <Grid>
                                    <TextBlock Text="CPU" FontSize="10" Foreground="{StaticResource BrushFaintText}" />
                                    <TextBlock x:Name="txtCpuTemp" FontSize="10" Foreground="{StaticResource BrushSubtleText}" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar x:Name="gaugeCpu" Style="{StaticResource Gauge}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="3">
                                <Grid>
                                    <TextBlock Text="GPU" FontSize="10" Foreground="{StaticResource BrushFaintText}" />
                                    <TextBlock x:Name="txtGpuTemp" FontSize="10" Foreground="{StaticResource BrushSubtleText}" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar x:Name="gaugeGpu" Style="{StaticResource Gauge}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="3">
                                <Grid>
                                    <TextBlock Text="MEM" FontSize="10" Foreground="{StaticResource BrushFaintText}" />
                                    <TextBlock x:Name="txtMemLoad" FontSize="10" Foreground="{StaticResource BrushSubtleText}" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar x:Name="gaugeMem" Style="{StaticResource Gauge}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Toggles ── -->
                <Border x:Name="cardToggles"
                        Padding="12,7"
                        CornerRadius="10"
                        Background="{StaticResource BrushCard}"
                        BorderBrush="{StaticResource BrushCardStroke}"
                        BorderThickness="1">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button x:Name="buttonFnLock" Style="{StaticResource Segment}" Content="Fn Lock" Click="FnLockClick" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button x:Name="buttonOverlay" Style="{StaticResource Segment}" Content="Overlay" Click="OverlayClick" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button x:Name="buttonBatteryFull" Style="{StaticResource Segment}" Content="100%" Click="BatteryFullClick" />
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
