<Page
    x:Class="GHelper.GameBar.GHelperSettingsWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="CardBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#A6FFFFFF" />
                    <SolidColorBrush x:Key="OnlineBrush" Color="#3ECF3E" />
                    <SolidColorBrush x:Key="OfflineBrush" Color="#FF6B6B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#8A000000" />
                    <SolidColorBrush x:Key="OnlineBrush" Color="#1E8B2E" />
                    <SolidColorBrush x:Key="OfflineBrush" Color="#C42B1C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="Root" Background="Transparent" Padding="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection status -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,12">
            <Ellipse x:Name="dotStatus" Width="8" Height="8" VerticalAlignment="Center" />
            <TextBlock x:Name="txtStatus" FontSize="12" Opacity="0.8" VerticalAlignment="Center" Text="connecting" />
        </StackPanel>

        <!--
            Everything the widget can change lives on the main widget, so this page is
            informational: it reports what G-Helper currently has applied and points at the
            settings that only the G-Helper window owns.
        -->
        <Border Grid.Row="1"
                Padding="14"
                CornerRadius="8"
                Background="{ThemeResource CardBrush}">
            <StackPanel>
                <TextBlock Text="G-Helper" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="txtModel" FontSize="12" Opacity="0.85" Margin="0,8,0,0" TextWrapping="Wrap" Text="-" />

                <TextBlock x:Name="txtMode" FontSize="12" Opacity="0.8" Margin="0,6,0,0" TextWrapping="Wrap" Text="-" />
                <TextBlock x:Name="txtGpuMode" FontSize="12" Opacity="0.8" Margin="0,4,0,0" TextWrapping="Wrap" Text="-" />

                <TextBlock FontSize="11" Opacity="0.6" Margin="0,14,0,0" TextWrapping="Wrap"
                           Text="Fan curves, custom modes, lighting and keybindings live in the G-Helper window." />

                <TextBlock x:Name="txtBridge" FontSize="11" Opacity="0.5" Margin="0,10,0,0" TextWrapping="Wrap" Text="" />
            </StackPanel>
        </Border>

        <Button x:Name="buttonRetry"
                Grid.Row="2"
                Margin="0,12,0,0"
                Content="Reconnect"
                HorizontalAlignment="Stretch"
                Click="RetryClick" />
    </Grid>
</Page>